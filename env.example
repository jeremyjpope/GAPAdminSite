#--------------------------------------------------------------------
# GAP Admin Site - environment template. Copy to .env and fill in.
#--------------------------------------------------------------------
CI_ENVIRONMENT = production

app.baseURL = 'https://admin.gapdbc.org/'
app.forceGlobalSecureRequests = true

# Production database (MySQL/MariaDB on the Moodle server, separate schema)
database.default.hostname = localhost
database.default.database = gapadmin
database.default.username = gapadmin
database.default.password = ''
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306
database.default.DBDebug = false

session.driver = 'CodeIgniter\Session\Handlers\FileHandler'

# Moodle integration
# url: the Moodle site. Users log in to the admin site with their Moodle credentials.
# wsToken: a web-service token for an admin-level Moodle user, used server-side to
#          read cohorts, users and grades. Create it in Moodle under
#          Site administration > Server > Web services > Manage tokens
#          (service: "Moodle mobile web service").
moodle.url = 'https://moodle.gapdbc.org'
moodle.wsToken = ''
moodle.loginService = 'moodle_mobile_app'
app.indexPage = ''
